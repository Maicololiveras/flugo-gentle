{
  "name": "gentle-live-observer",
  "version": "1.0.0",
  "type": "module",
  "description": "Local live event visualizer for Pi and Gentle Shell",
  "keywords": [
    "pi-package",
    "pi-extension",
    "gentle-ai",
    "live-observer"
  ],
  "files": [
    "extensions",
    "lib",
    "web",
    "README.md",
    "workspace.mjs",
    "import-benchmarks.mjs",
    "BENCHMARKS.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/observer.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node demo.mjs",
    "test:visual": "node qa/visual.mjs",
    "workspace": "node workspace.mjs",
    "test:workspace": "node qa/workspace-smoke.mjs",
    "test:benchmarks:visual": "node qa/benchmarks.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=24"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15",
    "ws": "8.21.0",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  }
}
