{
  "name": "gentle-live-observer",
  "version": "0.2.0",
  "type": "module",
  "description": "Local live event visualizer for Pi and Gentle Shell",
  "files": [
    "extensions",
    "lib",
    "web",
    "README.md",
    "workspace.mjs"
  ],
  "pi": {
    "extensions": [
      "./extensions/observer.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node demo.mjs",
    "test:visual": "node qa/visual.mjs",
    "workspace": "node workspace.mjs",
    "test:workspace": "node qa/workspace-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=24"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15",
    "ws": "8.21.0",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0"
  }
}
